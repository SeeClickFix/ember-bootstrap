{
  "name": "ember-bootstrap",
  "version": "5.0.0",
  "description": "Bootstrap components for Ember.js",
  "keywords": [
    "ember-addon",
    "bootstrap"
  ],
  "homepage": "https://www.ember-bootstrap.com/",
  "bugs": {
    "url": "https://github.com/kaliber5/ember-bootstrap/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kaliber5/ember-bootstrap"
  },
  "license": "MIT",
  "author": "Simon Ihmig <ihmig@kaliber5.de>",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "build": "ember build --environment=production",
    "docs:build": "yarn --cwd docs docs:build",
    "docs:serve": "yarn --cwd docs docs:serve",
    "lint": "concurrently \"npm:lint:*(!fix)\" --names \"lint:\"",
    "lint:fix": "concurrently \"npm:lint:*:fix\" --names \"fix:\"",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "nodetest": "mocha node-tests --recursive",
    "lint:js:fix": "eslint . --fix",
    "start": "ember serve",
    "test": "concurrently \"npm:lint\" \"npm:test:*\" --names \"lint,test:\"",
    "test:ember": "ember test",
    "test:ember-compatibility": "ember try:each"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.js": "eslint --cache --fix"
  },
  "resolutions": {
    "ip-regex": "^2.1.0",
    "ember-modifier": "^3.2.7",
    "lodash": "^4.18.1",
    "testem": "~3.18.0",
    "@embroider/addon-shim": "1.10.2",
    "pkg-entry-points": "1.1.1",
    "ember-a11y-testing/ember-auto-import": "^2.10.0",
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "browserslist": "^4.28.7",
    "tmp": "^0.2.7",
    "brace-expansion": "^1.1.21",
    "minimatch": "^3.1.5",
    "picomatch": "^2.3.2",
    "braces": "^3.0.3",
    "fast-uri": "^3.1.9",
    "nanoid": "^3.3.18",
    "markdown-it": "^14.3.3",
    "lodash.template": "^4.18.1",
    "ansi-html": "0.0.9",
    "mocha/js-yaml": "^4.3.2"
  },
  "dependencies": {
    "@ember/render-modifiers": "^2.1.0",
    "@ember/string": "^3.1.1",
    "@embroider/macros": "^1.8.3",
    "@embroider/util": "^1.13.3",
    "broccoli-debug": "^0.6.3",
    "broccoli-funnel": "^3.0.6",
    "broccoli-merge-trees": "^4.2.0",
    "chalk": "^4.1.1",
    "ember-auto-import": "^2.2.0",
    "ember-cli-babel": "^7.26.10",
    "ember-cli-build-config-editor": "0.5.1",
    "ember-cli-htmlbars": "^5.7.2",
    "ember-cli-version-checker": "^5.1.2",
    "ember-concurrency": "^2.1.2",
    "ember-decorators": "^6.1.0",
    "ember-element-helper": "^0.7.1",
    "ember-focus-trap": "^1.0.0",
    "ember-in-element-polyfill": "^1.0.1",
    "ember-named-blocks-polyfill": "^0.2.4",
    "ember-on-helper": "^0.1.0",
    "ember-popper-modifier": "^3.0.0",
    "ember-ref-bucket": "^4.1.0",
    "ember-render-helpers": "0.2.0",
    "ember-style-modifier": "^0.7.0",
    "findup-sync": "^4.0.0",
    "fs-extra": "^9.1.0",
    "handlebars": "^4.7.10",
    "lodash": "^4.18.1",
    "postcss": "^8.5.29",
    "resolve": "^1.18.1",
    "rsvp": "^4.0.1",
    "silent-error": "^1.0.1",
    "tracked-toolbox": "^1.2.3"
  },
  "devDependencies": {
    "@babel/core": "^7.0.0-0",
    "@babel/eslint-parser": "^7.22.15",
    "@babel/plugin-proposal-decorators": "^7.23.2",
