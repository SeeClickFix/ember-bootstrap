    "@ember/test-helpers": "^2.9.6",
    "@embroider/test-setup": "^3.0.2",
    "@glimmer/component": "^1.1.2",
    "@glimmer/tracking": "^1.1.2",
    "bootstrap": "^4.6.0",
    "bootstrap-sass": "^3.3.7",
    "broccoli-asset-rev": "^3.0.0",
    "chai": "^4.3.4",
    "chai-things": "^0.2.0",
    "concurrently": "^8.2.2",
    "ember-a11y-testing": "^4.0.7",
    "ember-cli": "~3.28.6",
    "ember-cli-app-version": "^4.0.0",
    "ember-cli-blueprint-test-helpers": "^0.19.1",
    "ember-cli-browserstack": "^1.1.0",
    "ember-cli-content-security-policy": "^2.0.0-4",
    "ember-cli-dependency-checker": "^3.3.2",
    "ember-cli-fastboot": "^4.1.1",
    "ember-cli-fastboot-testing": "0.6.1",
    "ember-cli-inject-live-reload": "^2.1.0",
    "ember-cli-sri": "^2.1.1",
    "ember-cli-terser": "^4.0.2",
    "ember-cli-test-loader": "^3.0.0",
    "ember-load-initializers": "^2.1.2",
    "ember-modifier": "^3.2.7",
    "ember-page-title": "^8.0.0",
    "ember-qunit": "^6.2.0",
    "ember-resolver": "^8.1.0",
    "ember-sinon": "^5.0.0",
    "ember-sinon-qunit": "^5.0.0",
    "ember-source": "~4.8.0",
    "ember-source-channel-url": "^3.0.0",
    "ember-template-lint": "^3.15.0",
    "ember-try": "^3.0.0",
    "eslint": "^8.52.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-ember": "^11.11.1",
    "eslint-plugin-hbs": "^1.0.0",
    "eslint-plugin-n": "^16.2.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-qunit": "^6.2.0",
    "glob": "^7.1.7",
    "husky": "^4.3.8",
    "jquery": "^3.7.1",
    "lint-staged": "^11.0.0",
    "loader.js": "^4.7.0",
    "mocha": "^8.4.0",
    "popper.js": "^1.6.1",
    "prettier": "^3.0.3",
    "qunit": "^2.20.0",
    "qunit-dom": "^2.0.0",
    "util": "^0.12.5",
    "webpack": "^5.89.0"
  },
  "peerDependencies": {
    "@glimmer/component": "^1.0.4 || ^2.0.0",
    "@glimmer/tracking": "^1.0.4",
    "ember-modifier": "^3.2.7 || ^4.0.0",
    "ember-source": ">=4.8.0"
  },
  "engines": {
    "node": ">= 18"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "configPath": "tests/dummy/config",
    "versionCompatibility": {
      "ember": ">=4.8.0"
    },
    "demoURL": "https://www.ember-bootstrap.com"
  }
}
